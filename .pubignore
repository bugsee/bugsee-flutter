# Used by `pub publish` INSTEAD of .gitignore (pub reads one or the other per directory),
# so everything in .gitignore is repeated here, then the dev-only trees: the iOS
# wrapper test package (its Sources is a symlink that would be published as a full
# duplicate of the plugin's Objective-C sources), the pigeon code generator and the sibling package.
# test/native_versions_test.dart asserts the .gitignore rules are all here.
# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not publish pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock
# (the repository commits it for CI: see .gitignore).
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Dev-only; not part of the package
/ios/wrapper_tests/
/pigeons/
# The sibling feedback package is published by itself, from its own directory.
/packages/
# The device verification harness (PLAN.md Phase 7) and the app it drives: dev tooling, never published.
/scripts/device/
/example/lib/verify_main.dart
/test/device_harness_test.dart
